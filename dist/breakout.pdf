stream
var G_ROWS = 23;
var G_COLS = 42;

// Helpers shared by every game. Plain ES5 on purpose: Acrobat's JavaScript
// engine is old, so no let/const, arrow functions or newer string methods.

var G_KEYS = {};        // key -> button name, e.g. { " ": "drop" }
var G_RAW_KEYS = false; // true = W A S D are letters, not arrows
var G_TICK = 0;         // ms between tick() calls, 0 = no timer

var DIRV = {
  up:    { x: 0,  y: -1 },
  down:  { x: 0,  y: 1 },
  left:  { x: -1, y: 0 },
  right: { x: 1,  y: 0 }
};
var DIR_NAMES = ["up", "down", "left", "right"];
var OPP = { up: "down", down: "up", left: "right", right: "left" };

function rnd(n) {
  return Math.floor(Math.random() * n);
}

function rep(text, n) {
  var s = "";
  for (var i = 0; i < n; i++) s += text;
  return s;
}

function padR(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : text + rep(" ", n - text.length);
}

function padL(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : rep(" ", n - text.length) + text;
}

// Centers text in a row n characters wide.
function mid(text, n) {
  text = String(text);
  if (n === undefined) n = G_COLS;
  var left = Math.max(0, Math.floor((n - text.length) / 2));
  return padR(rep(" ", left) + text, n);
}

function overlay(row, text, at) {
  return row.slice(0, at) + text + row.slice(at + text.length);
}

// Writes " TEXT " over the middle of a row (the middle row by default).
function banner(rows, text, at) {
  var label = " " + text + " ";
  if (at === undefined) at = Math.floor(rows.length / 2);
  var row = padR(rows[at] || "", G_COLS);
  rows[at] = overlay(row, label, Math.max(0, Math.floor((row.length - label.length) / 2)));
  return rows;
}

function grid(w, h, value) {
  var g = [];
  for (var y = 0; y < h; y++) {
    var row = [];
    for (var x = 0; x < w; x++) row.push(value);
    g.push(row);
  }
  return g;
}

function copyGrid(g) {
  var out = [];
  for (var y = 0; y < g.length; y++) out.push(g[y].slice());
  return out;
}

function shuffle(list) {
  for (var i = list.length - 1; i > 0; i--) {
    var j = rnd(i + 1);
    var t = list[i]; list[i] = list[j]; list[j] = t;
  }
  return list;
}

// Lower is better (moves, seconds): only counts finished games.
function lowerBest(best, value) {
  return best === null || value < best ? value : best;
}

var G_TICK = 80;
var G_KEYS = { " ": "launch" };

var FW = 40;
var FH = 22;
var BRICK_TOP = 2;
var BRICK_ROWS = 5;
var BRICK_W = 4;
var PADDLE_Y = 20;
var PADDLE_W = 8;
var BRICK_LOOK = ["[##]", "[==]", "[::]", "[--]", "[..]"];
var BRICK_POINTS = [25, 20, 15, 10, 5];

function newBricks() {
  return grid(FW / BRICK_W, BRICK_ROWS, true);
}

function gNew() {
  var s = { bricks: newBricks(), left: (FW / BRICK_W) * BRICK_ROWS, px: (FW - PADDLE_W) / 2, lives: 3, score: 0, level: 1, status: "ready" };
  stick(s);
  return s;
}

function stick(s) {
  s.stuck = true;
  s.bx = s.px + PADDLE_W / 2;
  s.by = PADDLE_Y - 1;
  s.dx = 1; s.dy = -1;
}

function brickAt(s, x, y) {
  var r = y - BRICK_TOP;
  if (r < 0 || r >= BRICK_ROWS || x < 0 || x >= FW) return false;
  return s.bricks[r][Math.floor(x / BRICK_W)];
}

function hit(s, x, y) {
  var r = y - BRICK_TOP;
  s.bricks[r][Math.floor(x / BRICK_W)] = false;
  s.score += BRICK_POINTS[r];
  s.left--;
}

function solid(s, x, y) {
  return x < 0 || x >= FW || y < 0 || brickAt(s, x, y);
}

function moveBall(s) {
  var x = s.bx, y = s.by;
  if (x + s.dx < 0 || x + s.dx >= FW) s.dx = -s.dx;
  if (y + s.dy < 0) s.dy = -s.dy;
  if (brickAt(s, x, y + s.dy)) { hit(s, x, y + s.dy); s.dy = -s.dy; }
  else if (brickAt(s, x + s.dx, y)) { hit(s, x + s.dx, y); s.dx = -s.dx; }
  else if (brickAt(s, x + s.dx, y + s.dy)) { hit(s, x + s.dx, y + s.dy); s.dx = -s.dx; s.dy = -s.dy; }

  if (s.dy > 0 && y + s.dy === PADDLE_Y && x + s.dx >= s.px - 1 && x + s.dx <= s.px + PADDLE_W) {
    s.dy = -1;
    s.dx = x + s.dx < s.px + PADDLE_W / 2 ? -1 : 1;
  }
  var nx = x + s.dx, ny = y + s.dy;
  // If bouncing pointed us into something else, wait a tick instead.
  if (solid(s, nx, ny)) return;
  s.bx = nx; s.by = ny;
}

function gTick(s) {
  if (s.status !== "playing" || s.stuck) return false;
  moveBall(s);
  if (s.left === 0) {
    s.bricks = newBricks();
    s.left = (FW / BRICK_W) * BRICK_ROWS;
    s.level++;
    stick(s);
  } else if (s.by >= FH) {
    s.lives--;
    if (s.lives === 0) s.status = "over";
    else stick(s);
  }
  return true;
}

function gInput(s, kind, a) {
  if (s.status === "over") return kind === "dir" || kind === "btn" ? gNew() : null;
  if (kind === "dir" && (a === "left" || a === "right")) {
    s.px = Math.max(0, Math.min(FW - PADDLE_W, s.px + (a === "left" ? -3 : 3)));
    if (s.stuck) s.bx = s.px + PADDLE_W / 2;
  } else if ((kind === "dir" && a === "up") || (kind === "btn" && a === "launch")) {
    s.status = "playing";
    if (s.stuck) { s.stuck = false; s.dx = Math.random() < 0.5 ? -1 : 1; s.dy = -1; }
  }
  return null;
}

function gRows(s) {
  var rows = ["+" + rep("-", FW) + "+"];
  for (var y = 0; y < FH; y++) {
    var line = "";
    for (var x = 0; x < FW; x++) {
      var c = " ";
      if (brickAt(s, x, y)) c = BRICK_LOOK[y - BRICK_TOP].charAt(x % BRICK_W);
      if (y === PADDLE_Y && x >= s.px && x < s.px + PADDLE_W) c = "=";
      if (x === s.bx && y === s.by) c = "O";
      line += c;
    }
    rows.push("|" + line + "|");
  }
  if (s.status === "ready") banner(rows, "PRESS UP TO LAUNCH", 13);
  if (s.status === "over") banner(rows, "GAME OVER", 13);
  return rows;
}

function gStatus(s) {
  if (s.status === "over") return "Out of balls - press an arrow to play again";
  var hearts = "Balls: " + rep("O ", s.lives) + "  Level " + s.level;
  return s.stuck ? hearts + "  - Up / LAUNCH" : hearts;
}

// Glue between a game and the PDF form. Every game defines:
//   gNew()                    -> a fresh state with a .score
//   gInput(s, kind, a, b, c)  -> handles "dir", "btn", "key" and "cell";
//                                may return a new state to replace s
//   gTick(s)                  -> true if the screen changed
//   gRows(s), gStatus(s)      -> what to show
//   gBest(s, best)            -> optional, otherwise best = highest score
var doc = this;
var S = gNew();
var best = typeof G_BEST_START !== "undefined" ? G_BEST_START : 0;
var lastText = {};
var WASD = { w: "up", a: "left", s: "down", d: "right" };

function setField(name, text) {
  if (lastText[name] === text) return;
  doc.getField(name).value = text;
  lastText[name] = text;
}

function draw() {
  var rows = gRows(S);
  for (var i = 0; i < G_ROWS; i++) setField("row" + i, padR(rows[i] || "", G_COLS));
  setField("status", gStatus(S));
  if (typeof gBest === "function") best = gBest(S, best);
  else if (S.score > best) best = S.score;
  setField("score", String(S.score));
  setField("best", best === null ? "-" : String(best));
}

function input(kind, a, b, c) {
  var next = gInput(S, kind, a, b, c);
  if (next) S = next;
  draw();
}

function onArrow(dir) { input("dir", dir); }
function onBtn(name) { input("btn", name); }
function onCell(group, x, y) { input("cell", x, y, group); }

function onKey(text) {
  for (var i = 0; i < text.length; i++) {
    var k = text.charAt(i).toLowerCase();
    if (G_KEYS[k]) input("btn", G_KEYS[k]);
    else if (!G_RAW_KEYS && WASD[k]) input("dir", WASD[k]);
    else input("key", k);
  }
}

function tick() {
  if (gTick(S)) draw();
}

draw();
var timer = G_TICK > 0 ? app.setInterval("tick()", G_TICK) : null;

endstream
endobj
