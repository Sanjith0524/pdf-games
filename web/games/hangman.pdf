var G_ROWS = 12;
var G_COLS = 39;

// Helpers shared by every game. Plain ES5 on purpose: Acrobat's JavaScript
// engine is old, so no let/const, arrow functions or newer string methods.

var G_KEYS = {};        // key -> button name, e.g. { " ": "drop" }
var G_RAW_KEYS = false; // true = W A S D are letters, not arrows
var G_TICK = 0;         // ms between tick() calls, 0 = no timer

var DIRV = {
  up:    { x: 0,  y: -1 },
  down:  { x: 0,  y: 1 },
  left:  { x: -1, y: 0 },
  right: { x: 1,  y: 0 }
};
var DIR_NAMES = ["up", "down", "left", "right"];
var OPP = { up: "down", down: "up", left: "right", right: "left" };

function rnd(n) {
  return Math.floor(Math.random() * n);
}

function rep(text, n) {
  var s = "";
  for (var i = 0; i < n; i++) s += text;
  return s;
}

function padR(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : text + rep(" ", n - text.length);
}

function padL(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : rep(" ", n - text.length) + text;
}

// Centers text in a row n characters wide.
function mid(text, n) {
  text = String(text);
  if (n === undefined) n = G_COLS;
  var left = Math.max(0, Math.floor((n - text.length) / 2));
  return padR(rep(" ", left) + text, n);
}

function overlay(row, text, at) {
  return row.slice(0, at) + text + row.slice(at + text.length);
}

// Writes " TEXT " over the middle of a row (the middle row by default).
function banner(rows, text, at) {
  var label = " " + text + " ";
  if (at === undefined) at = Math.floor(rows.length / 2);
  var row = padR(rows[at] || "", G_COLS);
  rows[at] = overlay(row, label, Math.max(0, Math.floor((row.length - label.length) / 2)));
  return rows;
}

function grid(w, h, value) {
  var g = [];
  for (var y = 0; y < h; y++) {
    var row = [];
    for (var x = 0; x < w; x++) row.push(value);
    g.push(row);
  }
  return g;
}

function copyGrid(g) {
  var out = [];
  for (var y = 0; y < g.length; y++) out.push(g[y].slice());
  return out;
}

function shuffle(list) {
  for (var i = list.length - 1; i > 0; i--) {
    var j = rnd(i + 1);
    var t = list[i]; list[i] = list[j]; list[j] = t;
  }
  return list;
}

// Lower is better (moves, seconds): only counts finished games.
function lowerBest(best, value) {
  return best === null || value < best ? value : best;
}

var G_RAW_KEYS = true;
var G_KEYS = { " ": "new" };

var WORDS = ("ROCKET GUITAR JUNGLE PLANET WIZARD CASTLE DRAGON PUZZLE GALAXY ROBOT " +
  "PYTHON KEYBOARD MONITOR SANDWICH PENGUIN VOLCANO DIAMOND COMPASS LANTERN TORNADO " +
  "BALLOON CAMERA PIRATE JACKET KITCHEN LADDER MARBLE NAPKIN ORANGE PARROT " +
  "QUARTZ RABBIT SPIDER TICKET UMBRELLA VIOLIN WALRUS YOGURT ZIPPER ANCHOR " +
  "BRIDGE CACTUS DOLPHIN ENGINE FOSSIL GLACIER HAMMER IGLOO JIGSAW KOALA " +
  "LEMON MAGNET NOODLE OCTOPUS PEPPER QUIVER RIDDLE SAILOR TEACUP UNICORN " +
  "VELVET WAFFLE OXYGEN BUTTER CANYON DESERT FALCON GOBLIN HARBOR ISLAND " +
  "JOURNAL KETTLE LIZARD MEADOW NEBULA OYSTER PICKLE RAINBOW SCOOTER THUNDER " +
  "TRUMPET VOYAGE WHISTLE BLANKET CRAYON DONKEY ECLIPSE FIDDLE GARDEN HELMET " +
  "INSECT JELLY KAYAK LAPTOP MITTEN NUTMEG ORBIT PILLOW QUILT ROOSTER " +
  "SPHINX TOFFEE TURTLE VACUUM WHALE BREEZE COOKIE DYNAMO ESCAPE FROZEN").split(" ");
var ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
var MAX_WRONG = 6;

var GALLOWS = [
  ["  +---+  ", "  |   |  ", "      |  ", "      |  ", "      |  ", "      |  ", "========="],
  ["  +---+  ", "  |   |  ", "  O   |  ", "      |  ", "      |  ", "      |  ", "========="],
  ["  +---+  ", "  |   |  ", "  O   |  ", "  |   |  ", "      |  ", "      |  ", "========="],
  ["  +---+  ", "  |   |  ", "  O   |  ", " /|   |  ", "      |  ", "      |  ", "========="],
  ["  +---+  ", "  |   |  ", "  O   |  ", " /|\\  |  ", "      |  ", "      |  ", "========="],
  ["  +---+  ", "  |   |  ", "  O   |  ", " /|\\  |  ", " /    |  ", "      |  ", "========="],
  ["  +---+  ", "  |   |  ", "  O   |  ", " /|\\  |  ", " / \\  |  ", "      |  ", "========="]
];

function gNew(prev) {
  return {
    word: WORDS[rnd(WORDS.length)], used: {}, wrong: 0, status: "playing",
    score: prev ? prev.score : 0, top: prev ? prev.top : 0
  };
}

function solved(s) {
  for (var i = 0; i < s.word.length; i++) if (!s.used[s.word.charAt(i)]) return false;
  return true;
}

function guess(s, letter) {
  if (s.status !== "playing") return gNew(s);
  if (s.used[letter]) return null;
  s.used[letter] = true;
  if (s.word.indexOf(letter) < 0) s.wrong++;
  if (solved(s)) { s.status = "won"; s.score++; s.top = Math.max(s.top, s.score); }
  else if (s.wrong >= MAX_WRONG) { s.status = "lost"; s.score = 0; }
  return null;
}

function gInput(s, kind, a, b) {
  if (kind === "btn" && a === "new") {
    if (s.status === "playing") s.score = 0;   // giving up ends the streak
    return gNew(s);
  }
  if (kind === "cell") return guess(s, ALPHA.charAt(b * 13 + a));
  if (kind === "key") {
    var letter = a.toUpperCase();
    if (ALPHA.indexOf(letter) >= 0 && letter.length === 1) return guess(s, letter);
  }
  return null;
}

function gTick() { return false; }
function gBest(s) { return s.top; }

function gRows(s) {
  var rows = [], i, art = GALLOWS[Math.min(s.wrong, MAX_WRONG)];
  for (i = 0; i < art.length; i++) rows.push(mid(art[i]));
  rows.push("");
  var shown = [];
  for (i = 0; i < s.word.length; i++) {
    var c = s.word.charAt(i);
    shown.push(s.used[c] || s.status === "lost" ? c : "_");
  }
  rows.push(mid(shown.join(" ")));
  rows.push("");
  for (var r = 0; r < 2; r++) {
    var line = "";
    for (i = 0; i < 13; i++) {
      var letter = ALPHA.charAt(r * 13 + i);
      line += s.used[letter] ? (s.word.indexOf(letter) >= 0 ? "[" + letter + "]" : " - ") : " " + letter + " ";
    }
    rows.push(line);
  }
  return rows;
}

function gStatus(s) {
  if (s.status === "won") return "You got it! Click a letter to play again";
  if (s.status === "lost") return "Hanged! The word was " + s.word + ". Click to retry";
  return "Click letters or type them. Misses left: " + (MAX_WRONG - s.wrong);
}

// Glue between a game and the PDF form. Every game defines:
//   gNew()                    -> a fresh state with a .score
//   gInput(s, kind, a, b, c)  -> handles "dir", "btn", "key" and "cell";
//                                may return a new state to replace s
//   gTick(s)                  -> true if the screen changed
//   gRows(s), gStatus(s)      -> what to show
//   gBest(s, best)            -> optional, otherwise best = highest score
var doc = this;
var S = gNew();
var best = typeof G_BEST_START !== "undefined" ? G_BEST_START : 0;
var lastText = {};
var WASD = { w: "up", a: "left", s: "down", d: "right" };

function setField(name, text) {
  if (lastText[name] === text) return;
  doc.getField(name).value = text;
  lastText[name] = text;
}

function draw() {
  var rows = gRows(S);
  for (var i = 0; i < G_ROWS; i++) setField("row" + i, padR(rows[i] || "", G_COLS));
  setField("status", gStatus(S));
  if (typeof gBest === "function") best = gBest(S, best);
  else if (S.score > best) best = S.score;
  setField("score", String(S.score));
  setField("best", best === null ? "-" : String(best));
}

function input(kind, a, b, c) {
  var next = gInput(S, kind, a, b, c);
  if (next) S = next;
  draw();
}

function onArrow(dir) { input("dir", dir); }
function onBtn(name) { input("btn", name); }
function onCell(group, x, y) { input("cell", x, y, group); }

function onKey(text) {
  for (var i = 0; i < text.length; i++) {
    var k = text.charAt(i).toLowerCase();
    if (G_KEYS[k]) input("btn", G_KEYS[k]);
    else if (!G_RAW_KEYS && WASD[k]) input("dir", WASD[k]);
    else input("key", k);
  }
}

function tick() {
  if (gTick(S)) draw();
}

draw();
var timer = G_TICK > 0 ? app.setInterval("tick()", G_TICK) : null;

endstream
endobj
