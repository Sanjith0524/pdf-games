stream
var G_ROWS = 15;
var G_COLS = 31;

// Helpers shared by every game. Plain ES5 on purpose: Acrobat's JavaScript
// engine is old, so no let/const, arrow functions or newer string methods.

var G_KEYS = {};        // key -> button name, e.g. { " ": "drop" }
var G_RAW_KEYS = false; // true = W A S D are letters, not arrows
var G_TICK = 0;         // ms between tick() calls, 0 = no timer

var DIRV = {
  up:    { x: 0,  y: -1 },
  down:  { x: 0,  y: 1 },
  left:  { x: -1, y: 0 },
  right: { x: 1,  y: 0 }
};
var DIR_NAMES = ["up", "down", "left", "right"];
var OPP = { up: "down", down: "up", left: "right", right: "left" };

function rnd(n) {
  return Math.floor(Math.random() * n);
}

function rep(text, n) {
  var s = "";
  for (var i = 0; i < n; i++) s += text;
  return s;
}

function padR(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : text + rep(" ", n - text.length);
}

function padL(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : rep(" ", n - text.length) + text;
}

// Centers text in a row n characters wide.
function mid(text, n) {
  text = String(text);
  if (n === undefined) n = G_COLS;
  var left = Math.max(0, Math.floor((n - text.length) / 2));
  return padR(rep(" ", left) + text, n);
}

function overlay(row, text, at) {
  return row.slice(0, at) + text + row.slice(at + text.length);
}

// Writes " TEXT " over the middle of a row (the middle row by default).
function banner(rows, text, at) {
  var label = " " + text + " ";
  if (at === undefined) at = Math.floor(rows.length / 2);
  var row = padR(rows[at] || "", G_COLS);
  rows[at] = overlay(row, label, Math.max(0, Math.floor((row.length - label.length) / 2)));
  return rows;
}

function grid(w, h, value) {
  var g = [];
  for (var y = 0; y < h; y++) {
    var row = [];
    for (var x = 0; x < w; x++) row.push(value);
    g.push(row);
  }
  return g;
}

function copyGrid(g) {
  var out = [];
  for (var y = 0; y < g.length; y++) out.push(g[y].slice());
  return out;
}

function shuffle(list) {
  for (var i = list.length - 1; i > 0; i--) {
    var j = rnd(i + 1);
    var t = list[i]; list[i] = list[j]; list[j] = t;
  }
  return list;
}

// Lower is better (moves, seconds): only counts finished games.
function lowerBest(best, value) {
  return best === null || value < best ? value : best;
}

var G_RAW_KEYS = true;
var G_KEYS = { " ": "enter", "-": "del" };

var ANSWERS = ("APPLE BEACH BRAIN BREAD BRUSH CANDY CHAIR CHALK CHEST CLOCK " +
  "CLOUD CRANE CROWN DANCE DREAM DRINK EAGLE EARTH FEAST FIELD FLAME FLOUR " +
  "FROST FRUIT GHOST GIANT GLASS GRAPE GRASS HEART HONEY HORSE HOUSE JUICE " +
  "KNIFE LEMON LIGHT MAGIC MANGO MONEY MOUSE MUSIC NIGHT OCEAN OLIVE PAINT " +
  "PEACH PEARL PIANO PIZZA PLANT PLATE POINT QUEEN QUIET RADIO RIVER ROBOT " +
  "SALAD SCALE SHARK SHEEP SHELL SHIRT SHOES SKIRT SLEEP SMILE SNAKE SPACE " +
  "SPOON STAGE STONE STORM SUGAR SWEET TABLE TIGER TOAST TOOTH TORCH TOWER " +
  "TRAIN TRUCK UNCLE VOICE WATCH WATER WHALE WHEEL WORLD YOUTH ZEBRA BLAZE " +
  "BRAVE CABIN CHARM CRISP DWARF FABLE FLOCK GLOBE GROVE HAVEN IVORY JOLLY " +
  "KNACK LUNAR MAPLE NOBLE ORBIT PRISM QUILT RAVEN SCOUT SOLAR THYME VIVID " +
  "WALTZ YACHT ACORN BISON CORAL DELTA EMBER FROND GECKO HIPPO IGLOO JEWEL " +
  "KOALA LLAMA MOOSE NINJA OTTER PANDA QUAIL RHINO SQUID TULIP VIPER").split(" ");
var TRIES = 6;
var LEN = 5;
var KEY_ROWS = ["QWERTYUIOP", "ASDFGHJKL", "<ZXCVBNM>"];

function gNew(prev) {
  return {
    answer: ANSWERS[rnd(ANSWERS.length)], guesses: [], cur: "", status: "playing", note: "",
    known: {}, score: prev ? prev.score : 0, top: prev ? prev.top : 0
  };
}

// For each letter: 2 = right spot, 1 = in the word elsewhere, 0 = not in it.
function scoreGuess(answer, guess) {
  var marks = [], left = {}, i;
  for (i = 0; i < LEN; i++) {
    if (guess.charAt(i) === answer.charAt(i)) marks.push(2);
    else { marks.push(0); left[answer.charAt(i)] = (left[answer.charAt(i)] || 0) + 1; }
  }
  for (i = 0; i < LEN; i++) {
    var c = guess.charAt(i);
    if (marks[i] === 0 && left[c]) { marks[i] = 1; left[c]--; }
  }
  return marks;
}

function submit(s) {
  if (s.cur.length < LEN) { s.note = "Need 5 letters"; return; }
  var marks = scoreGuess(s.answer, s.cur);
  s.guesses.push({ word: s.cur, marks: marks });
  for (var i = 0; i < LEN; i++) {
    var c = s.cur.charAt(i);
    if (s.known[c] === undefined || marks[i] > s.known[c]) s.known[c] = marks[i];
  }
  if (s.cur === s.answer) { s.status = "won"; s.score++; s.top = Math.max(s.top, s.score); }
  else if (s.guesses.length === TRIES) { s.status = "lost"; s.score = 0; }
  s.cur = "";
}

function press(s, key) {
  if (s.status !== "playing") return gNew(s);
  s.note = "";
  if (key === "<") s.cur = s.cur.slice(0, -1);
  else if (key === ">") submit(s);
  else if (s.cur.length < LEN) s.cur += key;
  return null;
}

function gInput(s, kind, a, b, group) {
  if (kind === "btn" && a === "new") {
    if (s.status === "playing") s.score = 0;
    return gNew(s);
  }
  if (kind === "btn" && a === "enter") return press(s, ">");
  if (kind === "btn" && a === "del") return press(s, "<");
  if (kind === "key") {
    var k = a.toUpperCase();
    if (k.length === 1 && k >= "A" && k <= "Z") return press(s, k);
  }
  if (kind === "cell") {
    var row = KEY_ROWS[Number(group.charAt(1)) - 1];
    return press(s, row.charAt(a));
  }
  return null;
}

function gTick() { return false; }
function gBest(s) { return s.top; }

function tile(c, mark) {
  if (mark === 2) return "[" + c + "]";
  if (mark === 1) return "(" + c + ")";
  return " " + c + " ";
}

function gRows(s) {
  var rows = [], i, j;
  for (i = 0; i < TRIES; i++) {
    var parts = [];
    for (j = 0; j < LEN; j++) {
      if (i < s.guesses.length) {
        var g = s.guesses[i], c = g.word.charAt(j);
        parts.push(tile(g.marks[j] ? c : c.toLowerCase(), g.marks[j]));
      } else if (i === s.guesses.length && s.status === "playing") {
        parts.push(j < s.cur.length ? " " + s.cur.charAt(j) + " " : " _ ");
      } else {
        parts.push(" . ");
      }
    }
    rows.push(mid(parts.join(" ")));
    rows.push("");
  }
  for (i = 0; i < KEY_ROWS.length; i++) {
    var line = "";
    for (j = 0; j < KEY_ROWS[i].length; j++) {
      var k = KEY_ROWS[i].charAt(j);
      if (k === "<") line += "DEL";
      else if (k === ">") line += "ENT";
      else if (s.known[k] === 0) line += " . ";
      else line += tile(k, s.known[k]);
    }
    rows.push(mid(line));
  }
  if (s.status === "won") banner(rows, "GOT IT!", 11);
  if (s.status === "lost") banner(rows, "IT WAS " + s.answer, 11);
  return rows;
}

function gStatus(s) {
  if (s.status === "won") return "Solved in " + s.guesses.length + "! Click a key to play again";
  if (s.status === "lost") return "The word was " + s.answer + ". Click a key to play again";
  if (s.note) return s.note;
  return "[A] right spot  (A) wrong spot  a not in the word";
}

// Glue between a game and the PDF form. Every game defines:
//   gNew()                    -> a fresh state with a .score
//   gInput(s, kind, a, b, c)  -> handles "dir", "btn", "key" and "cell";
//                                may return a new state to replace s
//   gTick(s)                  -> true if the screen changed
//   gRows(s), gStatus(s)      -> what to show
//   gBest(s, best)            -> optional, otherwise best = highest score
var doc = this;
var S = gNew();
var best = typeof G_BEST_START !== "undefined" ? G_BEST_START : 0;
var lastText = {};
var WASD = { w: "up", a: "left", s: "down", d: "right" };

function setField(name, text) {
  if (lastText[name] === text) return;
  doc.getField(name).value = text;
  lastText[name] = text;
}

function draw() {
  var rows = gRows(S);
  for (var i = 0; i < G_ROWS; i++) setField("row" + i, padR(rows[i] || "", G_COLS));
  setField("status", gStatus(S));
  if (typeof gBest === "function") best = gBest(S, best);
  else if (S.score > best) best = S.score;
  setField("score", String(S.score));
  setField("best", best === null ? "-" : String(best));
}

function input(kind, a, b, c) {
  var next = gInput(S, kind, a, b, c);
  if (next) S = next;
  draw();
}

function onArrow(dir) { input("dir", dir); }
function onBtn(name) { input("btn", name); }
function onCell(group, x, y) { input("cell", x, y, group); }

function onKey(text) {
  for (var i = 0; i < text.length; i++) {
    var k = text.charAt(i).toLowerCase();
    if (G_KEYS[k]) input("btn", G_KEYS[k]);
    else if (!G_RAW_KEYS && WASD[k]) input("dir", WASD[k]);
    else input("key", k);
  }
}

function tick() {
  if (gTick(S)) draw();
}

draw();
var timer = G_TICK > 0 ? app.setInterval("tick()", G_TICK) : null;

endstream
endobj
