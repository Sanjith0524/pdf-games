stream
var GRID_W = 20;
var GRID_H = 15;
var START_LENGTH = 3;
var TICK_MS = 250;

var CELL_EMPTY = "  ";
var CELL_BODY = "[]";
var CELL_HEAD = "@@";
var CELL_DEAD = "XX";
var CELL_FOOD = "<>";
var CELL_WALL = "::";

function newState(random) {
  var cx = Math.floor(GRID_W / 2);
  var cy = Math.floor(GRID_H / 2);
  var snake = [];
  for (var i = 0; i < START_LENGTH; i++) {
    snake.push({ x: cx - i, y: cy });
  }
  var state = {
    snake: snake,
    dir: "right",
    nextDir: "right",
    food: null,
    score: 0,
    status: "ready"
  };
  placeFood(state, random);
  return state;
}

function startGame(random) {
  var state = newState(random);
  state.status = "playing";
  return state;
}

var DIRS = {
  up:    { x: 0,  y: -1 },
  down:  { x: 0,  y: 1 },
  left:  { x: -1, y: 0 },
  right: { x: 1,  y: 0 }
};

var OPPOSITE = { up: "down", down: "up", left: "right", right: "left" };

var KEY_DIRS = { w: "up", a: "left", s: "down", d: "right" };

function keyToDir(key) {
  return KEY_DIRS[key.toLowerCase()] || null;
}

function hits(cells, x, y) {
  for (var i = 0; i < cells.length; i++) {
    if (cells[i].x === x && cells[i].y === y) return true;
  }
  return false;
}

function placeFood(state, random) {
  var free = [];
  for (var y = 0; y < GRID_H; y++) {
    for (var x = 0; x < GRID_W; x++) {
      if (!hits(state.snake, x, y)) free.push({ x: x, y: y });
    }
  }
  if (free.length === 0) {
    state.food = null;
    state.status = "won";
    return;
  }
  state.food = free[Math.floor(random() * free.length)];
}

function turn(state, dir) {
  // Compare against the direction the snake actually moved last tick, so two
  // quick presses (e.g. up then left while going right) can't reverse it.
  if (dir === OPPOSITE[state.dir]) return state;
  state.nextDir = dir;
  return state;
}

function step(state, random) {
  if (state.status !== "playing") return false;

  state.dir = state.nextDir;
  var head = state.snake[0];
  var d = DIRS[state.dir];
  // Going off one edge brings you back in on the opposite edge. Adding the
  // grid size before % keeps the result positive when moving left/up from 0.
  var nx = (head.x + d.x + GRID_W) % GRID_W;
  var ny = (head.y + d.y + GRID_H) % GRID_H;

  var eating = state.food !== null && nx === state.food.x && ny === state.food.y;
  // The tail moves out of the way this tick unless we're growing.
  var body = eating ? state.snake : state.snake.slice(0, -1);
  if (hits(body, nx, ny)) {
    state.status = "dead";
    return true;
  }

  state.snake.unshift({ x: nx, y: ny });
  if (eating) {
    state.score++;
    placeFood(state, random);
  } else {
    state.snake.pop();
  }
  return true;
}

function repeat(text, count) {
  return new Array(count + 1).join(text);
}

function renderRows(state) {
  var grid = [];
  for (var y = 0; y < GRID_H; y++) {
    var row = [];
    for (var x = 0; x < GRID_W; x++) row.push(CELL_EMPTY);
    grid.push(row);
  }

  if (state.food) grid[state.food.y][state.food.x] = CELL_FOOD;

  for (var i = state.snake.length - 1; i >= 0; i--) {
    var part = state.snake[i];
    var cell = CELL_BODY;
    if (i === 0) cell = state.status === "dead" ? CELL_DEAD : CELL_HEAD;
    grid[part.y][part.x] = cell;
  }

  var wall = repeat(CELL_WALL, GRID_W + 2);
  var rows = [wall];
  for (var r = 0; r < GRID_H; r++) {
    rows.push(CELL_WALL + grid[r].join("") + CELL_WALL);
  }
  rows.push(wall);

  var banner = bannerText(state);
  if (banner) rows = withBanner(rows, banner);
  return rows;
}

function bannerText(state) {
  if (state.status === "ready") return "READY?";
  if (state.status === "dead") return "GAME OVER";
  if (state.status === "won") return "YOU WIN!";
  return null;
}

// Writes the text, padded with a space each side, into the middle of the
// middle row so it shows up on the game screen.
function withBanner(rows, text) {
  var label = " " + text + " ";
  var mid = Math.floor(rows.length / 2);
  var row = rows[mid];
  var start = Math.floor((row.length - label.length) / 2);
  rows[mid] = row.slice(0, start) + label + row.slice(start + label.length);
  return rows;
}

function statusText(state) {
  if (state.status === "ready") return "Press an arrow or W A S D to start";
  if (state.status === "dead") return "You bit yourself! Press an arrow to retry";
  if (state.status === "won") return "You filled the whole board!";
  return "Eat the <> and don't bite your tail";
}

var doc = this;
var state = newState(Math.random);
var best = 0;
var lastText = {};

function setField(name, text) {
  if (lastText[name] === text) return;
  doc.getField(name).value = text;
  lastText[name] = text;
}

function draw() {
  var rows = renderRows(state);
  for (var i = 0; i < rows.length; i++) setField("row" + i, rows[i]);
  setField("status", statusText(state));
  setField("score", String(state.score));
  setField("best", String(best));
}

function onArrow(dir) {
  if (state.status !== "playing") {
    state = startGame(Math.random);
  }
  turn(state, dir);
  draw();
}

function onKey(key) {
  var dir = keyToDir(key);
  if (dir) onArrow(dir);
}

function tick() {
  if (step(state, Math.random)) {
    if (state.score > best) best = state.score;
    draw();
  }
}

draw();

// Keep the returned timer in a variable: some viewers stop a timer whose
// object gets garbage collected.
var timer = app.setInterval("tick()", TICK_MS);

endstream
endobj
