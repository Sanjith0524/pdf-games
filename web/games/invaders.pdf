stream
var G_ROWS = 20;
var G_COLS = 40;

// Helpers shared by every game. Plain ES5 on purpose: Acrobat's JavaScript
// engine is old, so no let/const, arrow functions or newer string methods.

var G_KEYS = {};        // key -> button name, e.g. { " ": "drop" }
var G_RAW_KEYS = false; // true = W A S D are letters, not arrows
var G_TICK = 0;         // ms between tick() calls, 0 = no timer

var DIRV = {
  up:    { x: 0,  y: -1 },
  down:  { x: 0,  y: 1 },
  left:  { x: -1, y: 0 },
  right: { x: 1,  y: 0 }
};
var DIR_NAMES = ["up", "down", "left", "right"];
var OPP = { up: "down", down: "up", left: "right", right: "left" };

function rnd(n) {
  return Math.floor(Math.random() * n);
}

function rep(text, n) {
  var s = "";
  for (var i = 0; i < n; i++) s += text;
  return s;
}

function padR(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : text + rep(" ", n - text.length);
}

function padL(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : rep(" ", n - text.length) + text;
}

// Centers text in a row n characters wide.
function mid(text, n) {
  text = String(text);
  if (n === undefined) n = G_COLS;
  var left = Math.max(0, Math.floor((n - text.length) / 2));
  return padR(rep(" ", left) + text, n);
}

function overlay(row, text, at) {
  return row.slice(0, at) + text + row.slice(at + text.length);
}

// Writes " TEXT " over the middle of a row (the middle row by default).
function banner(rows, text, at) {
  var label = " " + text + " ";
  if (at === undefined) at = Math.floor(rows.length / 2);
  var row = padR(rows[at] || "", G_COLS);
  rows[at] = overlay(row, label, Math.max(0, Math.floor((row.length - label.length) / 2)));
  return rows;
}

function grid(w, h, value) {
  var g = [];
  for (var y = 0; y < h; y++) {
    var row = [];
    for (var x = 0; x < w; x++) row.push(value);
    g.push(row);
  }
  return g;
}

function copyGrid(g) {
  var out = [];
  for (var y = 0; y < g.length; y++) out.push(g[y].slice());
  return out;
}

function shuffle(list) {
  for (var i = list.length - 1; i > 0; i--) {
    var j = rnd(i + 1);
    var t = list[i]; list[i] = list[j]; list[j] = t;
  }
  return list;
}

// Lower is better (moves, seconds): only counts finished games.
function lowerBest(best, value) {
  return best === null || value < best ? value : best;
}

var G_TICK = 60;
var G_KEYS = { " ": "fire" };

var IW = 40;
var IH = 20;
var COLS = 8;
var ROWS = 5;
var GROUND = IH - 1;
var PLAYER_Y = IH - 2;
var SHIELD_Y = IH - 5;
var SHIELD_XS = [4, 14, 23, 32];
var LOOKS = [["<o>", ">o<"], ["{O}", "}O{"], ["{O}", "}O{"], ["/M\\", "\\M/"], ["/M\\", "\\M/"]];
var POINTS = [30, 20, 20, 10, 10];

function newWave(s) {
  s.alive = grid(COLS, ROWS, true);
  s.count = COLS * ROWS;
  s.fx = 2;
  s.fy = 1 + Math.min(3, s.wave - 1);
  s.fdir = 1;
  s.wait = 0;
  s.frame = 0;
  s.bombs = [];
  s.shot = null;
}

function gNew() {
  var s = { px: Math.floor(IW / 2) - 1, lives: 3, score: 0, wave: 1, status: "ready", dead: 0, shield: {} };
  for (var i = 0; i < SHIELD_XS.length; i++) {
    for (var dx = 0; dx < 4; dx++) {
      s.shield[(SHIELD_XS[i] + dx) + "," + SHIELD_Y] = true;
      s.shield[(SHIELD_XS[i] + dx) + "," + (SHIELD_Y + 1)] = true;
    }
  }
  newWave(s);
  return s;
}

function alienAt(s, x, y) {
  for (var j = 0; j < ROWS; j++) {
    if (y !== s.fy + j * 2) continue;
    for (var i = 0; i < COLS; i++) {
      var ax = s.fx + i * 4;
      if (s.alive[j][i] && x >= ax && x < ax + 3) return [i, j];
    }
  }
  return null;
}

function moveFleet(s) {
  var minI = COLS, maxI = -1, maxJ = -1;
  for (var j = 0; j < ROWS; j++) for (var i = 0; i < COLS; i++) {
    if (s.alive[j][i]) { minI = Math.min(minI, i); maxI = Math.max(maxI, i); maxJ = Math.max(maxJ, j); }
  }
  var left = s.fx + minI * 4 + s.fdir, right = s.fx + maxI * 4 + 2 + s.fdir;
  if (left < 0 || right >= IW) { s.fy++; s.fdir = -s.fdir; }
  else s.fx += s.fdir;
  s.frame = 1 - s.frame;
  var bottom = s.fy + maxJ * 2;
  // Aliens chew through shields they walk into.
  for (var key in s.shield) if (s.shield[key] && Number(key.split(",")[1]) <= bottom) s.shield[key] = false;
  if (bottom >= PLAYER_Y) { s.status = "over"; s.lives = 0; }
}

function dropBomb(s) {
  var cols = [];
  for (var i = 0; i < COLS; i++) {
    for (var j = ROWS - 1; j >= 0; j--) if (s.alive[j][i]) { cols.push([i, j]); break; }
  }
  if (!cols.length) return;
  var pick = cols[rnd(cols.length)];
  s.bombs.push({ x: s.fx + pick[0] * 4 + 1, y: s.fy + pick[1] * 2 + 1 });
}

function hitShield(s, x, y) {
  var key = x + "," + y;
  if (s.shield[key]) { s.shield[key] = false; return true; }
  return false;
}

function gTick(s) {
  if (s.status !== "playing") return false;
  s.tick = (s.tick || 0) + 1;
  if (s.dead > 0) {
    s.dead--;
    return true;
  }
  if (s.shot) {
    s.shot.y--;
    var a = alienAt(s, s.shot.x, s.shot.y);
    if (a) {
      s.alive[a[1]][a[0]] = false;
      s.count--;
      s.score += POINTS[a[1]];
      s.shot = null;
    } else if (s.shot.y < 0 || hitShield(s, s.shot.x, s.shot.y)) {
      s.shot = null;
    }
  }
  if (s.count === 0) {
    s.wave++;
    newWave(s);
    return true;
  }
  if (++s.wait >= 1 + Math.floor(s.count / 4)) {
    s.wait = 0;
    moveFleet(s);
    if (s.status === "over") return true;
  }
  if (s.bombs.length < 2 + s.wave && Math.random() < 0.05 + s.wave * 0.01) dropBomb(s);
  if (s.tick % 2 === 0) {
    var kept = [];
    for (var i = 0; i < s.bombs.length; i++) {
      var b = s.bombs[i];
      b.y++;
      if (hitShield(s, b.x, b.y) || b.y >= GROUND) continue;
      if (b.y === PLAYER_Y && b.x >= s.px && b.x < s.px + 3) {
        s.lives--;
        s.dead = 20;
        kept = [];
        if (s.lives === 0) s.status = "over";
        break;
      }
      kept.push(b);
    }
    s.bombs = kept;
  }
  return true;
}

function gInput(s, kind, a) {
  if (kind !== "dir" && kind !== "btn") return null;
  if (s.status === "over") return gNew();
  if (s.status === "ready") { s.status = "playing"; return null; }
  if (s.dead > 0) return null;
  if (a === "left") s.px = Math.max(0, s.px - 2);
  if (a === "right") s.px = Math.min(IW - 3, s.px + 2);
  if ((a === "up" || a === "fire") && !s.shot) s.shot = { x: s.px + 1, y: PLAYER_Y - 1 };
  return null;
}

function gRows(s) {
  var g = grid(IW, IH, " "), x, y, i, j;
  for (var key in s.shield) {
    if (!s.shield[key]) continue;
    var p = key.split(",");
    g[Number(p[1])][Number(p[0])] = "#";
  }
  for (j = 0; j < ROWS; j++) for (i = 0; i < COLS; i++) {
    if (!s.alive[j][i]) continue;
    var look = LOOKS[j][s.frame];
    y = s.fy + j * 2;
    for (x = 0; x < 3; x++) if (y < IH) g[y][s.fx + i * 4 + x] = look.charAt(x);
  }
  for (i = 0; i < s.bombs.length; i++) g[s.bombs[i].y][s.bombs[i].x] = "!";
  if (s.shot && s.shot.y >= 0) g[s.shot.y][s.shot.x] = "|";
  var ship = s.dead > 0 && s.dead % 4 < 2 ? "\\*/" : "/A\\";
  if (s.lives > 0 || s.dead > 0) for (x = 0; x < 3; x++) g[PLAYER_Y][s.px + x] = ship.charAt(x);
  for (x = 0; x < IW; x++) g[GROUND][x] = "=";
  var rows = [];
  for (y = 0; y < IH; y++) rows.push(g[y].join(""));
  if (s.status === "ready") banner(rows, "PRESS AN ARROW TO START", 12);
  if (s.status === "over") banner(rows, "GAME OVER", 12);
  return rows;
}

function gStatus(s) {
  if (s.status === "over") return "The invaders got you - press an arrow to retry";
  return "Ships: " + rep("A ", s.lives) + "  Wave " + s.wave + "   Up / FIRE shoots";
}

// Glue between a game and the PDF form. Every game defines:
//   gNew()                    -> a fresh state with a .score
//   gInput(s, kind, a, b, c)  -> handles "dir", "btn", "key" and "cell";
//                                may return a new state to replace s
//   gTick(s)                  -> true if the screen changed
//   gRows(s), gStatus(s)      -> what to show
//   gBest(s, best)            -> optional, otherwise best = highest score
var doc = this;
var S = gNew();
var best = typeof G_BEST_START !== "undefined" ? G_BEST_START : 0;
var lastText = {};
var WASD = { w: "up", a: "left", s: "down", d: "right" };

function setField(name, text) {
  if (lastText[name] === text) return;
  doc.getField(name).value = text;
  lastText[name] = text;
}

function draw() {
  var rows = gRows(S);
  for (var i = 0; i < G_ROWS; i++) setField("row" + i, padR(rows[i] || "", G_COLS));
  setField("status", gStatus(S));
  if (typeof gBest === "function") best = gBest(S, best);
  else if (S.score > best) best = S.score;
  setField("score", String(S.score));
  setField("best", best === null ? "-" : String(best));
}

function input(kind, a, b, c) {
  var next = gInput(S, kind, a, b, c);
  if (next) S = next;
  draw();
}

function onArrow(dir) { input("dir", dir); }
function onBtn(name) { input("btn", name); }
function onCell(group, x, y) { input("cell", x, y, group); }

function onKey(text) {
  for (var i = 0; i < text.length; i++) {
    var k = text.charAt(i).toLowerCase();
    if (G_KEYS[k]) input("btn", G_KEYS[k]);
    else if (!G_RAW_KEYS && WASD[k]) input("dir", WASD[k]);
    else input("key", k);
  }
}

function tick() {
  if (gTick(S)) draw();
}

draw();
var timer = G_TICK > 0 ? app.setInterval("tick()", G_TICK) : null;

endstream
endobj
