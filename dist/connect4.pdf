var G_ROWS = 14;
var G_COLS = 43;

// Helpers shared by every game. Plain ES5 on purpose: Acrobat's JavaScript
// engine is old, so no let/const, arrow functions or newer string methods.

var G_KEYS = {};        // key -> button name, e.g. { " ": "drop" }
var G_RAW_KEYS = false; // true = W A S D are letters, not arrows
var G_TICK = 0;         // ms between tick() calls, 0 = no timer

var DIRV = {
  up:    { x: 0,  y: -1 },
  down:  { x: 0,  y: 1 },
  left:  { x: -1, y: 0 },
  right: { x: 1,  y: 0 }
};
var DIR_NAMES = ["up", "down", "left", "right"];
var OPP = { up: "down", down: "up", left: "right", right: "left" };

function rnd(n) {
  return Math.floor(Math.random() * n);
}

function rep(text, n) {
  var s = "";
  for (var i = 0; i < n; i++) s += text;
  return s;
}

function padR(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : text + rep(" ", n - text.length);
}

function padL(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : rep(" ", n - text.length) + text;
}

// Centers text in a row n characters wide.
function mid(text, n) {
  text = String(text);
  if (n === undefined) n = G_COLS;
  var left = Math.max(0, Math.floor((n - text.length) / 2));
  return padR(rep(" ", left) + text, n);
}

function overlay(row, text, at) {
  return row.slice(0, at) + text + row.slice(at + text.length);
}

// Writes " TEXT " over the middle of a row (the middle row by default).
function banner(rows, text, at) {
  var label = " " + text + " ";
  if (at === undefined) at = Math.floor(rows.length / 2);
  var row = padR(rows[at] || "", G_COLS);
  rows[at] = overlay(row, label, Math.max(0, Math.floor((row.length - label.length) / 2)));
  return rows;
}

function grid(w, h, value) {
  var g = [];
  for (var y = 0; y < h; y++) {
    var row = [];
    for (var x = 0; x < w; x++) row.push(value);
    g.push(row);
  }
  return g;
}

function copyGrid(g) {
  var out = [];
  for (var y = 0; y < g.length; y++) out.push(g[y].slice());
  return out;
}

function shuffle(list) {
  for (var i = list.length - 1; i > 0; i--) {
    var j = rnd(i + 1);
    var t = list[i]; list[i] = list[j]; list[j] = t;
  }
  return list;
}

// Lower is better (moves, seconds): only counts finished games.
function lowerBest(best, value) {
  return best === null || value < best ? value : best;
}

var G_RAW_KEYS = true;
var G_KEYS = { n: "new", l: "level" };

var CW = 7;
var CH = 6;
var starts = "you";

function gNew(prev) {
  var s = {
    b: grid(CW, CH, ""), status: "playing", win: null, last: -1,
    score: prev ? prev.score : 0, cpu: prev ? prev.cpu : 0, hard: prev ? prev.hard : true
  };
  starts = prev ? (starts === "you" ? "cpu" : "you") : "you";
  if (starts === "cpu") drop(s, 3, "O");
  return s;
}

function dropRow(b, col) {
  for (var y = CH - 1; y >= 0; y--) if (!b[y][col]) return y;
  return -1;
}

function drop(s, col, who) {
  var y = dropRow(s.b, col);
  if (y < 0) return false;
  s.b[y][col] = who;
  s.last = col;
  return true;
}

var DIRS4 = [[1, 0], [0, 1], [1, 1], [1, -1]];

function findWin(b) {
  for (var y = 0; y < CH; y++) for (var x = 0; x < CW; x++) {
    var who = b[y][x];
    if (!who) continue;
    for (var d = 0; d < 4; d++) {
      var cells = [[x, y]];
      for (var k = 1; k < 4; k++) {
        var nx = x + DIRS4[d][0] * k, ny = y + DIRS4[d][1] * k;
        if (nx < 0 || ny < 0 || nx >= CW || ny >= CH || b[ny][nx] !== who) break;
        cells.push([nx, ny]);
      }
      if (cells.length === 4) return { who: who, cells: cells };
    }
  }
  return null;
}

function full(b) {
  for (var x = 0; x < CW; x++) if (!b[0][x]) return false;
  return true;
}

// Scores every window of four: more of your pieces with no opponent is better.
function evaluate(b) {
  var score = 0;
  for (var y = 0; y < CH; y++) if (b[y][3] === "O") score += 3; else if (b[y][3] === "X") score -= 3;
  for (y = 0; y < CH; y++) for (var x = 0; x < CW; x++) for (var d = 0; d < 4; d++) {
    var o = 0, p = 0, ok = true;
    for (var k = 0; k < 4; k++) {
      var nx = x + DIRS4[d][0] * k, ny = y + DIRS4[d][1] * k;
      if (nx < 0 || ny < 0 || nx >= CW || ny >= CH) { ok = false; break; }
      if (b[ny][nx] === "O") o++; else if (b[ny][nx] === "X") p++;
    }
    if (!ok || (o && p)) continue;
    if (o === 3) score += 5; else if (o === 2) score += 2;
    if (p === 3) score -= 6; else if (p === 2) score -= 2;
  }
  return score;
}

var ORDER = [3, 2, 4, 1, 5, 0, 6];

function search(b, depth, alpha, beta, turn) {
  var w = findWin(b);
  if (w) return w.who === "O" ? 100000 + depth : -100000 - depth;
  if (depth === 0 || full(b)) return evaluate(b);
  for (var i = 0; i < CW; i++) {
    var col = ORDER[i], y = dropRow(b, col);
    if (y < 0) continue;
    b[y][col] = turn;
    var v = search(b, depth - 1, alpha, beta, turn === "O" ? "X" : "O");
    b[y][col] = "";
    if (turn === "O") { if (v > alpha) alpha = v; } else if (v < beta) beta = v;
    if (alpha >= beta) break;
  }
  return turn === "O" ? alpha : beta;
}

function cpuMove(s) {
  // Depth 4 keeps each move well under a second even in slow PDF viewers.
  var depth = s.hard ? 4 : 1, bestV = -Infinity, pick = -1;
  for (var i = 0; i < CW; i++) {
    var col = ORDER[i], y = dropRow(s.b, col);
    if (y < 0) continue;
    s.b[y][col] = "O";
    var v = s.hard ? search(s.b, depth, bestV, Infinity, "X") : search(s.b, depth, -Infinity, Infinity, "X") + Math.random() * 8;
    s.b[y][col] = "";
    if (v > bestV) { bestV = v; pick = col; }
  }
  if (pick >= 0) drop(s, pick, "O");
}

function finish(s) {
  var w = findWin(s.b);
  if (w) {
    s.status = "over"; s.win = w;
    if (w.who === "X") s.score++; else s.cpu++;
    return true;
  }
  if (full(s.b)) { s.status = "over"; s.win = { who: "draw", cells: [] }; return true; }
  return false;
}

function play(s, col) {
  if (s.status !== "playing" || !drop(s, col, "X")) return null;
  if (!finish(s)) { cpuMove(s); finish(s); }
  return null;
}

function gInput(s, kind, a) {
  if (kind === "btn" && a === "new") return gNew(s);
  if (kind === "btn" && a === "level") { s.hard = !s.hard; return null; }
  if (s.status === "over" && (kind === "cell" || kind === "key")) return gNew(s);
  if (kind === "cell") return play(s, a);
  if (kind === "key" && a >= "1" && a <= "7") return play(s, Number(a) - 1);
  return null;
}

function gTick() { return false; }
function gBest(s) { return s.cpu; }

function isWinCell(s, x, y) {
  if (!s.win) return false;
  for (var i = 0; i < s.win.cells.length; i++) if (s.win.cells[i][0] === x && s.win.cells[i][1] === y) return true;
  return false;
}

function gRows(s) {
  var head = " ";
  for (var x = 0; x < CW; x++) head += mid(x === s.last ? "v" + (x + 1) + "v" : String(x + 1), 5) + " ";
  var rows = [head];
  for (var y = 0; y < CH; y++) {
    var top = "|", bottom = "|";
    for (x = 0; x < CW; x++) {
      var c = s.b[y][x], hot = isWinCell(s, x, y);
      if (c === "X") { top += hot ? "[***]" : "[XXX]"; bottom += hot ? "[***]" : "[XXX]"; }
      else if (c === "O") { top += hot ? "(***)" : "(OOO)"; bottom += hot ? "(***)" : "(OOO)"; }
      else { top += "     "; bottom += "  .  "; }
      top += "|"; bottom += "|";
    }
    rows.push(top, bottom);
  }
  rows.push("+" + rep("-----+", CW));
  return rows;
}

function gStatus(s) {
  if (s.status === "over") {
    var msg = s.win.who === "X" ? "You win!" : s.win.who === "O" ? "CPU wins." : "Draw.";
    return msg + " Click the board to play again";
  }
  return "You are [XXX]. Click a column or press 1-7. Level: " + (s.hard ? "HARD" : "EASY");
}

// Glue between a game and the PDF form. Every game defines:
//   gNew()                    -> a fresh state with a .score
//   gInput(s, kind, a, b, c)  -> handles "dir", "btn", "key" and "cell";
//                                may return a new state to replace s
//   gTick(s)                  -> true if the screen changed
//   gRows(s), gStatus(s)      -> what to show
//   gBest(s, best)            -> optional, otherwise best = highest score
var doc = this;
var S = gNew();
var best = typeof G_BEST_START !== "undefined" ? G_BEST_START : 0;
var lastText = {};
var WASD = { w: "up", a: "left", s: "down", d: "right" };

function setField(name, text) {
  if (lastText[name] === text) return;
  doc.getField(name).value = text;
  lastText[name] = text;
}

function draw() {
  var rows = gRows(S);
  for (var i = 0; i < G_ROWS; i++) setField("row" + i, padR(rows[i] || "", G_COLS));
  setField("status", gStatus(S));
  if (typeof gBest === "function") best = gBest(S, best);
  else if (S.score > best) best = S.score;
  setField("score", String(S.score));
  setField("best", best === null ? "-" : String(best));
}

function input(kind, a, b, c) {
  var next = gInput(S, kind, a, b, c);
  if (next) S = next;
  draw();
}

function onArrow(dir) { input("dir", dir); }
function onBtn(name) { input("btn", name); }
function onCell(group, x, y) { input("cell", x, y, group); }

function onKey(text) {
  for (var i = 0; i < text.length; i++) {
    var k = text.charAt(i).toLowerCase();
    if (G_KEYS[k]) input("btn", G_KEYS[k]);
    else if (!G_RAW_KEYS && WASD[k]) input("dir", WASD[k]);
    else input("key", k);
  }
}

function tick() {
  if (gTick(S)) draw();
}

draw();
var timer = G_TICK > 0 ? app.setInterval("tick()", G_TICK) : null;

endstream
endobj
