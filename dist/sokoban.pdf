stream
var G_ROWS = 12;
var G_COLS = 24;

// Helpers shared by every game. Plain ES5 on purpose: Acrobat's JavaScript
// engine is old, so no let/const, arrow functions or newer string methods.

var G_KEYS = {};        // key -> button name, e.g. { " ": "drop" }
var G_RAW_KEYS = false; // true = W A S D are letters, not arrows
var G_TICK = 0;         // ms between tick() calls, 0 = no timer

var DIRV = {
  up:    { x: 0,  y: -1 },
  down:  { x: 0,  y: 1 },
  left:  { x: -1, y: 0 },
  right: { x: 1,  y: 0 }
};
var DIR_NAMES = ["up", "down", "left", "right"];
var OPP = { up: "down", down: "up", left: "right", right: "left" };

function rnd(n) {
  return Math.floor(Math.random() * n);
}

function rep(text, n) {
  var s = "";
  for (var i = 0; i < n; i++) s += text;
  return s;
}

function padR(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : text + rep(" ", n - text.length);
}

function padL(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : rep(" ", n - text.length) + text;
}

// Centers text in a row n characters wide.
function mid(text, n) {
  text = String(text);
  if (n === undefined) n = G_COLS;
  var left = Math.max(0, Math.floor((n - text.length) / 2));
  return padR(rep(" ", left) + text, n);
}

function overlay(row, text, at) {
  return row.slice(0, at) + text + row.slice(at + text.length);
}

// Writes " TEXT " over the middle of a row (the middle row by default).
function banner(rows, text, at) {
  var label = " " + text + " ";
  if (at === undefined) at = Math.floor(rows.length / 2);
  var row = padR(rows[at] || "", G_COLS);
  rows[at] = overlay(row, label, Math.max(0, Math.floor((row.length - label.length) / 2)));
  return rows;
}

function grid(w, h, value) {
  var g = [];
  for (var y = 0; y < h; y++) {
    var row = [];
    for (var x = 0; x < w; x++) row.push(value);
    g.push(row);
  }
  return g;
}

function copyGrid(g) {
  var out = [];
  for (var y = 0; y < g.length; y++) out.push(g[y].slice());
  return out;
}

function shuffle(list) {
  for (var i = list.length - 1; i > 0; i--) {
    var j = rnd(i + 1);
    var t = list[i]; list[i] = list[j]; list[j] = t;
  }
  return list;
}

// Lower is better (moves, seconds): only counts finished games.
function lowerBest(best, value) {
  return best === null || value < best ? value : best;
}

var G_KEYS = { u: "undo", r: "restart", n: "skip" };

// # wall   . goal   $ box   * box on goal   @ player   + player on goal
var LEVELS = [
  [
    "#####",
    "#@  #",
    "# $ #",
    "#  .#",
    "#####"
  ],
  [
    "######",
    "#    #",
    "# $$ #",
    "#  @ #",
    "#.  .#",
    "######"
  ],
  [
    "########",
    "#  .   #",
    "# $$$  #",
    "#. @ .##",
    "#  #  #",
    "########"
  ],
  [
    "  ####",
    "###  ####",
    "#     $ #",
    "# #  #$ #",
    "# . .#@ #",
    "#########"
  ],
  [
    " #######",
    " #  .  #",
    "## $#$ #",
    "#  . @ #",
    "# $#.  #",
    "#      #",
    "########"
  ],
  [
    "  #####",
    "###   #",
    "#.@$  #",
    "### $.#",
    "#.##$ #",
    "# # . ##",
    "#$ *$$.#",
    "#   .  #",
    "########"
  ]
];

function loadLevel(n) {
  var rows = LEVELS[n], s = { lvl: n, wall: [], goal: [], box: [], px: 0, py: 0, moves: 0, score: 0, history: [], status: "playing" };
  s.h = rows.length;
  s.w = 0;
  for (var y = 0; y < rows.length; y++) s.w = Math.max(s.w, rows[y].length);
  for (y = 0; y < s.h; y++) {
    s.wall.push([]); s.goal.push([]); s.box.push([]);
    for (var x = 0; x < s.w; x++) {
      var c = rows[y].charAt(x) || " ";
      s.wall[y].push(c === "#");
      s.goal[y].push(c === "." || c === "*" || c === "+");
      s.box[y].push(c === "$" || c === "*");
      if (c === "@" || c === "+") { s.px = x; s.py = y; }
    }
  }
  return s;
}

function gNew() { return loadLevel(0); }

function solved(s) {
  for (var y = 0; y < s.h; y++) for (var x = 0; x < s.w; x++) if (s.box[y][x] && !s.goal[y][x]) return false;
  return true;
}

function free(s, x, y) {
  return x >= 0 && y >= 0 && x < s.w && y < s.h && !s.wall[y][x] && !s.box[y][x];
}

function step(s, dir) {
  var d = DIRV[dir], nx = s.px + d.x, ny = s.py + d.y;
  if (nx < 0 || ny < 0 || nx >= s.w || ny >= s.h || s.wall[ny][nx]) return;
  var pushed = false;
  if (s.box[ny][nx]) {
    if (!free(s, nx + d.x, ny + d.y)) return;
    s.box[ny][nx] = false;
    s.box[ny + d.y][nx + d.x] = true;
    pushed = true;
  }
  s.history.push({ px: s.px, py: s.py, dir: dir, pushed: pushed });
  s.px = nx; s.py = ny;
  s.moves++;
  if (solved(s)) s.status = "solved";
}

function undo(s) {
  var h = s.history.pop();
  if (!h) return;
  if (h.pushed) {
    var d = DIRV[h.dir];
    s.box[s.py + d.y][s.px + d.x] = false;
    s.box[s.py][s.px] = true;
  }
  s.px = h.px; s.py = h.py;
  s.moves--;
  s.status = "playing";
}

function nextLevel(s) {
  return s.lvl + 1 < LEVELS.length ? loadLevel(s.lvl + 1) : loadLevel(0);
}

function gInput(s, kind, a) {
  if (kind === "btn") {
    if (a === "undo") undo(s);
    if (a === "restart") return loadLevel(s.lvl);
    if (a === "skip") return nextLevel(s);
  }
  if (kind !== "dir") return null;
  if (s.status === "solved") return nextLevel(s);
  step(s, a);
  s.score = s.moves;
  return null;
}

function gTick() { return false; }

function gBest(s) { return (s.lvl + 1) + "/" + LEVELS.length; }

function gRows(s) {
  var rows = [mid("LEVEL " + (s.lvl + 1) + " OF " + LEVELS.length), ""];
  for (var y = 0; y < s.h; y++) {
    var line = "";
    for (var x = 0; x < s.w; x++) {
      if (x === s.px && y === s.py) line += "@@";
      else if (s.wall[y][x]) line += "##";
      else if (s.box[y][x]) line += s.goal[y][x] ? "{}" : "[]";
      else if (s.goal[y][x]) line += "<>";
      else line += "  ";
    }
    rows.push(mid(line));
  }
  if (s.status === "solved") banner(rows, "SOLVED!", rows.length);
  return rows;
}

function gStatus(s) {
  if (s.status === "solved") {
    return s.lvl + 1 < LEVELS.length ? "Solved in " + s.moves + " moves! Arrow for next level" : "You beat every level! Arrow to start over";
  }
  return "Push every [] onto a <>. U undoes, R restarts";
}

// Glue between a game and the PDF form. Every game defines:
//   gNew()                    -> a fresh state with a .score
//   gInput(s, kind, a, b, c)  -> handles "dir", "btn", "key" and "cell";
//                                may return a new state to replace s
//   gTick(s)                  -> true if the screen changed
//   gRows(s), gStatus(s)      -> what to show
//   gBest(s, best)            -> optional, otherwise best = highest score
var doc = this;
var S = gNew();
var best = typeof G_BEST_START !== "undefined" ? G_BEST_START : 0;
var lastText = {};
var WASD = { w: "up", a: "left", s: "down", d: "right" };

function setField(name, text) {
  if (lastText[name] === text) return;
  doc.getField(name).value = text;
  lastText[name] = text;
}

function draw() {
  var rows = gRows(S);
  for (var i = 0; i < G_ROWS; i++) setField("row" + i, padR(rows[i] || "", G_COLS));
  setField("status", gStatus(S));
  if (typeof gBest === "function") best = gBest(S, best);
  else if (S.score > best) best = S.score;
  setField("score", String(S.score));
  setField("best", best === null ? "-" : String(best));
}

function input(kind, a, b, c) {
  var next = gInput(S, kind, a, b, c);
  if (next) S = next;
  draw();
}

function onArrow(dir) { input("dir", dir); }
function onBtn(name) { input("btn", name); }
function onCell(group, x, y) { input("cell", x, y, group); }

function onKey(text) {
  for (var i = 0; i < text.length; i++) {
    var k = text.charAt(i).toLowerCase();
    if (G_KEYS[k]) input("btn", G_KEYS[k]);
    else if (!G_RAW_KEYS && WASD[k]) input("dir", WASD[k]);
    else input("key", k);
  }
}

function tick() {
  if (gTick(S)) draw();
}

draw();
var timer = G_TICK > 0 ? app.setInterval("tick()", G_TICK) : null;

endstream
endobj
