stream
var G_ROWS = 14;
var G_COLS = 34;

// Helpers shared by every game. Plain ES5 on purpose: Acrobat's JavaScript
// engine is old, so no let/const, arrow functions or newer string methods.

var G_KEYS = {};        // key -> button name, e.g. { " ": "drop" }
var G_RAW_KEYS = false; // true = W A S D are letters, not arrows
var G_TICK = 0;         // ms between tick() calls, 0 = no timer

var DIRV = {
  up:    { x: 0,  y: -1 },
  down:  { x: 0,  y: 1 },
  left:  { x: -1, y: 0 },
  right: { x: 1,  y: 0 }
};
var DIR_NAMES = ["up", "down", "left", "right"];
var OPP = { up: "down", down: "up", left: "right", right: "left" };

function rnd(n) {
  return Math.floor(Math.random() * n);
}

function rep(text, n) {
  var s = "";
  for (var i = 0; i < n; i++) s += text;
  return s;
}

function padR(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : text + rep(" ", n - text.length);
}

function padL(text, n) {
  text = String(text);
  return text.length >= n ? text.slice(0, n) : rep(" ", n - text.length) + text;
}

// Centers text in a row n characters wide.
function mid(text, n) {
  text = String(text);
  if (n === undefined) n = G_COLS;
  var left = Math.max(0, Math.floor((n - text.length) / 2));
  return padR(rep(" ", left) + text, n);
}

function overlay(row, text, at) {
  return row.slice(0, at) + text + row.slice(at + text.length);
}

// Writes " TEXT " over the middle of a row (the middle row by default).
function banner(rows, text, at) {
  var label = " " + text + " ";
  if (at === undefined) at = Math.floor(rows.length / 2);
  var row = padR(rows[at] || "", G_COLS);
  rows[at] = overlay(row, label, Math.max(0, Math.floor((row.length - label.length) / 2)));
  return rows;
}

function grid(w, h, value) {
  var g = [];
  for (var y = 0; y < h; y++) {
    var row = [];
    for (var x = 0; x < w; x++) row.push(value);
    g.push(row);
  }
  return g;
}

function copyGrid(g) {
  var out = [];
  for (var y = 0; y < g.length; y++) out.push(g[y].slice());
  return out;
}

function shuffle(list) {
  for (var i = list.length - 1; i > 0; i--) {
    var j = rnd(i + 1);
    var t = list[i]; list[i] = list[j]; list[j] = t;
  }
  return list;
}

// Lower is better (moves, seconds): only counts finished games.
function lowerBest(best, value) {
  return best === null || value < best ? value : best;
}

var G_TICK = 100;

var PAD_W = 10;
var PAD_H = 4;
// Pads sit in a diamond, matching the arrow buttons.
var PADS = [
  { dir: "up",    label: "UP",    row: 0,  col: 12 },
  { dir: "left",  label: "LEFT",  row: 5,  col: 0 },
  { dir: "right", label: "RIGHT", row: 5,  col: 24 },
  { dir: "down",  label: "DOWN",  row: 10, col: 12 }
];

function gNew() {
  return { seq: [], pos: 0, phase: "ready", lit: -1, timer: 0, idx: 0, score: 0, missed: -1 };
}

function padIndex(dir) {
  for (var i = 0; i < PADS.length; i++) if (PADS[i].dir === dir) return i;
  return -1;
}

function nextRound(s) {
  s.seq.push(rnd(4));
  s.phase = "show";
  s.idx = 0;
  s.timer = 6;
  s.lit = -1;
}

// Pads flash a little quicker every few rounds.
function onTicks(s) { return Math.max(2, 5 - Math.floor(s.seq.length / 5)); }

function gTick(s) {
  if (s.timer > 0) { s.timer--; return false; }
  if (s.phase === "show") {
    if (s.lit >= 0) {
      s.lit = -1;
      s.idx++;
      s.timer = 1;
    } else if (s.idx < s.seq.length) {
      s.lit = s.seq[s.idx];
      s.timer = onTicks(s);
    } else {
      s.phase = "input";
      s.pos = 0;
    }
    return true;
  }
  if (s.phase === "input" && s.lit >= 0) { s.lit = -1; return true; }
  if (s.phase === "next") { nextRound(s); return true; }
  return false;
}

function press(s, pad) {
  if (s.phase === "ready" || s.phase === "over") {
    var fresh = gNew();
    nextRound(fresh);
    return fresh;
  }
  if (s.phase !== "input") return null;
  s.lit = pad;
  s.timer = 2;
  if (pad !== s.seq[s.pos]) {
    s.phase = "over";
    s.missed = s.seq[s.pos];
    s.lit = s.missed;
    return null;
  }
  s.pos++;
  if (s.pos === s.seq.length) {
    s.score = s.seq.length;
    s.phase = "next";
    s.timer = 8;
  }
  return null;
}

function gInput(s, kind, a, b, group) {
  if (kind === "dir") return press(s, padIndex(a));
  if (kind === "cell") return press(s, padIndex(group));
  if (kind === "btn" && a === "start" && (s.phase === "ready" || s.phase === "over")) return press(s, -1);
  return null;
}

function padRows(i, lit) {
  var p = PADS[i];
  if (lit) {
    var full = rep("#", PAD_W);
    return [full, overlay(full, " " + p.label + " ", Math.floor((PAD_W - p.label.length - 2) / 2)), full, full];
  }
  var edge = "+" + rep("-", PAD_W - 2) + "+";
  return [edge, "|" + mid(p.label, PAD_W - 2) + "|", "|" + rep(" ", PAD_W - 2) + "|", edge];
}

function gRows(s) {
  var rows = [];
  for (var r = 0; r < 14; r++) rows.push(rep(" ", 34));
  for (var i = 0; i < PADS.length; i++) {
    var art = padRows(i, s.lit === i);
    for (var k = 0; k < PAD_H; k++) rows[PADS[i].row + k] = overlay(rows[PADS[i].row + k], art[k], PADS[i].col);
  }
  var centre = s.phase === "ready" ? "START" : s.phase === "over" ? "OOPS!" : "ROUND " + s.seq.length;
  rows[6] = overlay(rows[6], mid(centre, 12), 11);
  rows[7] = overlay(rows[7], mid(s.phase === "show" ? "watch..." : s.phase === "input" ? "your turn" : "", 12), 11);
  return rows;
}

function gStatus(s) {
  if (s.phase === "ready") return "Press any arrow or pad to start";
  if (s.phase === "over") return "Wrong! It was " + PADS[s.missed].label + ". Press a pad to retry";
  if (s.phase === "show") return "Watch the pattern...";
  if (s.phase === "input") return "Repeat it: " + s.pos + " of " + s.seq.length;
  return "Nice! Get ready for the next round";
}

// Glue between a game and the PDF form. Every game defines:
//   gNew()                    -> a fresh state with a .score
//   gInput(s, kind, a, b, c)  -> handles "dir", "btn", "key" and "cell";
//                                may return a new state to replace s
//   gTick(s)                  -> true if the screen changed
//   gRows(s), gStatus(s)      -> what to show
//   gBest(s, best)            -> optional, otherwise best = highest score
var doc = this;
var S = gNew();
var best = typeof G_BEST_START !== "undefined" ? G_BEST_START : 0;
var lastText = {};
var WASD = { w: "up", a: "left", s: "down", d: "right" };

function setField(name, text) {
  if (lastText[name] === text) return;
  doc.getField(name).value = text;
  lastText[name] = text;
}

function draw() {
  var rows = gRows(S);
  for (var i = 0; i < G_ROWS; i++) setField("row" + i, padR(rows[i] || "", G_COLS));
  setField("status", gStatus(S));
  if (typeof gBest === "function") best = gBest(S, best);
  else if (S.score > best) best = S.score;
  setField("score", String(S.score));
  setField("best", best === null ? "-" : String(best));
}

function input(kind, a, b, c) {
  var next = gInput(S, kind, a, b, c);
  if (next) S = next;
  draw();
}

function onArrow(dir) { input("dir", dir); }
function onBtn(name) { input("btn", name); }
function onCell(group, x, y) { input("cell", x, y, group); }

function onKey(text) {
  for (var i = 0; i < text.length; i++) {
    var k = text.charAt(i).toLowerCase();
    if (G_KEYS[k]) input("btn", G_KEYS[k]);
    else if (!G_RAW_KEYS && WASD[k]) input("dir", WASD[k]);
    else input("key", k);
  }
}

function tick() {
  if (gTick(S)) draw();
}

draw();
var timer = G_TICK > 0 ? app.setInterval("tick()", G_TICK) : null;

endstream
endobj
